<resources>
    <string name="app_name">Photo Sphere</string>

    <string name="permission_camera_title">Camera access needed</string>
    <string name="permission_camera_rationale">Photo Sphere stitches a 360° panorama from frames it captures as you pan the device, so it needs access to the camera.</string>
    <string name="permission_camera_denied_permanently">Camera access is turned off for this app. Enable it in Settings to capture a sphere.</string>
    <string name="permission_storage_rationale">Storage access is needed to save finished spheres to your gallery on this version of Android.</string>
    <string name="permission_grant">Grant access</string>
    <string name="permission_open_settings">Open settings</string>

    <string name="capture_starting">Starting camera…</string>
    <string name="capture_failed">Capture failed: %1$s</string>

    <!-- Guided capture HUD. -->
    <string name="capture_progress">%1$d / %2$d frames</string>
    <string name="capture_lock_infinity">Exposure &amp; white balance locked · focus at infinity</string>
    <string name="capture_lock_first">Exposure &amp; white balance locked · focus locked</string>
    <string name="capture_lock_fixed">Exposure &amp; white balance locked · fixed-focus lens</string>
    <string name="capture_hint_search">Move the reticle onto the marker</string>
    <string name="capture_hint_hold">Hold still…</string>
    <string name="capture_waiting_for_orientation">Finding your bearing…</string>
    <string name="capture_low_accuracy">Compass unreliable — wave the phone in a figure eight</string>
    <string name="capture_orientation_unavailable">This device has no rotation vector sensor, so guided capture is unavailable.</string>
    <string name="capture_sphere_complete">Sphere complete</string>
    <string name="capture_restart">Start a new sphere</string>
    <string name="capture_finish_stitch">Finish &amp; stitch</string>
    <string name="capture_instructions_title">Before you start</string>
    <string name="capture_instructions_1">Stand in one spot and rotate your body in place — don\'t walk.</string>
    <string name="capture_instructions_2">Hold the phone steady and level, turning it around a fixed point as you pan.</string>
    <string name="capture_instructions_3">The shutter fires on its own — pause a moment on each marker.</string>
    <string name="capture_instructions_4">Avoid blank walls and bright skies, and move slowly.</string>
    <string name="capture_instructions_dismiss">Got it</string>

    <!-- Stitching. -->
    <string name="stitch_title">Building your sphere</string>
    <string name="stitch_stage_preparing">Getting ready…</string>
    <string name="stitch_stage_reading">Reading frames (%1$d / %2$d)</string>
    <string name="stitch_stage_stitching">Aligning and blending frames…</string>
    <string name="stitch_stage_projecting">Shaping the equirectangular image…</string>
    <string name="stitch_cancel">Cancel</string>
    <string name="stitch_failed">Stitch failed. %1$s</string>
    <string name="stitch_error_need_more_images">Not enough overlapping frames — capture more of the sphere and try again.</string>
    <string name="stitch_error_alignment">The frames don\'t line up. Turn the phone on the spot rather than walking around, and avoid blank walls or open sky.</string>
    <string name="stitch_error_camera_estimation">The frames couldn\'t be resolved into one camera view. Try capturing the sphere again.</string>
    <string name="stitch_error_opencv_unavailable">Stitching is unavailable on this device — the OpenCV library did not load.</string>
    <string name="stitch_error_unreadable_input">A captured frame could not be read. Start a new sphere.</string>
    <string name="stitch_error_out_of_memory">Ran out of memory. Close other apps and try again with fewer frames.</string>
    <string name="stitch_error_unknown">Something went wrong (code %1$d).</string>
    <string name="stitch_error_write_failed">The sphere couldn\'t be written to storage. Free up some space and try again.</string>

