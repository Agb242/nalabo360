local.properties

# Local OpenCV SDK, if you use Option B from the README.
/third_party/

# Built APKs. A debug build is ~43 MB because OpenCV ships native libraries for
# every ABI, so committing one per rebuild grows the history by that much each
# time. Test builds are published as GitHub Release assets instead — see the
# "Test builds" section of the README.
*.apk

# Kotlin Multiplatform build outputs: composeApp (Gradle) and the .ipa assembly
# scratch space under iosApp (see iosApp/build-ipa.sh).
composeApp/build/
iosApp/build/

# One-off local tooling (migration patch scripts, logcat dumps).
.tools/
